# ============================================================================
# ChronoVerse – Umgebungsvariablen (.env.example -> .env kopieren)
# Alle Dienste laufen zu 100 % im kostenlosen Free-Tier (0,00 €)
# ============================================================================

# 1. Supabase (PostgreSQL DB + Auth für dich & Freunde)
# Kostenlos erstellen auf https://supabase.com -> Project Settings -> API
PUBLIC_SUPABASE_URL="https://dein-projekt.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="dein-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="dein-service-role-key-fuer-den-sync-worker"

# 2. TMDB API (Kostenlos für nicht-kommerzielle Projekte, keine Kreditkarte nötig)
# Kostenlos holen auf https://www.themoviedb.org/settings/api
TMDB_API_KEY="dein-tmdb-v3-api-key"

# 3. Gemini API Key (Für automatische Credit-Scene- & Road-to-Analyse via Google Search)
# Tipp für 100%ige 0,00 € Garantie in der Google Cloud Console:
# Unter "APIs & Services -> Generative Language API -> Quotas" das Limit
# "Requests per day" hart auf 10 setzen. Zusätzlich blockiert unser Code ab 25 Calls/Monat!
GEMINI_API_KEY="dein-gemini-api-key"
